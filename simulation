##################################################################################═
# COMPARATIVE MOSAIC — AUC gap ~ alpha, one panel per P (shared scales)
# Fixes the bug in the original script: gap_long_500/1000/2000 all pointed
# to the same gap_long object. Here each P keeps its own distinct gap_long,
# pulled directly from pipeline_results.
##################################################################################

all_gap <- bind_rows(lapply(P_SEQ, function(p) {
  pipeline_results[[as.character(p)]]$gap_long %>% mutate(p = p)
}))

x_range <- range(all_gap$alpha, na.rm = TRUE)
y_range <- range(all_gap$gap,   na.rm = TRUE)

make_gap_plot <- function(df, title_label) {
  ggplot(df, aes(x = alpha, y = gap)) +
    geom_jitter(width = 0.02, alpha = 0.4, color = "#6A1B9A") +
    geom_smooth(method = "lm", color = "#E65100", se = TRUE, linewidth = 1.2) +
    scale_x_continuous(limits = x_range) +
    scale_y_continuous(limits = y_range) +
    labs(x = "Alpha", y = "ΔAUC (internal − external)", title = title_label) +
    theme_minimal(base_size = 13)
}

gap_plots <- lapply(P_SEQ, function(p) {
  make_gap_plot(pipeline_results[[as.character(p)]]$gap_long, sprintf("P = %d", p))
})

mosaic_gap <- Reduce(`+`, gap_plots) + plot_layout(nrow = 1)
print(mosaic_gap)

ggsave(
  filename = file.path(ROOT_SAVE_DIR, "mosaic_gap_auc.png"),
  plot = mosaic_gap, width = 5 * length(P_SEQ), height = 5, dpi = 600
)

