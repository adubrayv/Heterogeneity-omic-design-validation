make_gap_plot <- function(df, title_label) {
  ggplot(df, aes(x = alpha, y = gap)) +
    geom_jitter(width = 0.02, alpha = 0.4, color = "#6A1B9A") +
    geom_smooth(method = "lm", color = "#E65100", se = TRUE, linewidth = 1.2) +
    scale_x_continuous(limits = x_range) +
    scale_y_continuous(limits = y_range) +
    labs(x = "Alpha", y = "ΔAUC (internal − external)", title = title_label) +
    theme_minimal(base_size = 13)
}

