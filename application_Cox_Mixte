clean_center <- function(X, surv_df, clin_df) {
  ok <- !is.na(surv_df$time) &
    !is.na(surv_df$event) &
    surv_df$time > 0 &
    surv_df$event %in% c(0, 1) &
    complete.cases(X) &
    complete.cases(clin_df)
  list(
    X = X[ok, , drop = FALSE],
    surv = surv_df[ok, , drop = FALSE],
    clin = clin_df[ok, , drop = FALSE]
  )
}

cleaned <- Map(clean_center, omics_list, surv_list, clinical_list)
