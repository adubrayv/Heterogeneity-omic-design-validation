## RANDOM COMPONENT (BETWEEN-CENTER VARIANCE)
###############################################################

variance_centre_mixed <- tryCatch(VarCorr(final_hybrid_mixed_model), error = function(e) NULL)
cat("\nVariance of the random effect (center):\n")
print(variance_centre_mixed)

###############################################################
## FIXED-EFFECT COEFFICIENTS OF THE FINAL MIXED MODEL
###############################################################

fe_final <- fixef(final_hybrid_mixed_model)
vc_final <- vcov(final_hybrid_mixed_model)
se_final <- sqrt(diag(vc_final))
z_final <- fe_final / se_final
p_final <- 2 * pnorm(-abs(z_final))

coef_final_hybrid_mixed <- data.frame(
  variable = names(fe_final),
  coefficient = as.numeric(fe_final),
  HR = exp(as.numeric(fe_final)),
  SE = as.numeric(se_final),
  z = as.numeric(z_final),
  p_value = as.numeric(p_final),
  CI95_lower = exp(as.numeric(fe_final) - 1.96 * as.numeric(se_final)),
  CI95_upper = exp(as.numeric(fe_final) + 1.96 * as.numeric(se_final)),
  row.names = NULL
)

print(coef_final_hybrid_mixed)

