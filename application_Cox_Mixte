cat("N external:", nrow(X_reserve_final), "\n")
cat("Omics variables (fixed effects):", length(consensus_vars_hybrid_mixed), "\n")
cat("Clinical variables (fixed effects): AGE + TNM\n")
cat("Random effect: intercept per center\n")
cat("AUC:", round(metrics_reserve_mixed["auc"], 4), "\n")
cat("C-index:", round(metrics_reserve_mixed["cindex"], 4), "\n")
cat("Brier:", round(metrics_reserve_mixed["brier"], 4), "\n")
cat("IBS:", round(metrics_reserve_mixed["ibs"], 4), "\n")
cat("Bures-Wasserstein (pre-filtering, n =", bw_prefilter_reserve$n_vars, "var.):",
    round(metrics_reserve_mixed["bw_prefilter"], 4), "\n")

