    )
  )
  
  center_outer_train <- factor(
    rep(
      center_names,
      sapply(
        center_names,
        function(cn) {
          sum(center_folds[[cn]] %in% train_ids)
        }
      )
    )
  )
  
  X_outer_val <- do.call(
    rbind,
    lapply(
      center_names,
      function(cn) {
        omics_list[[cn]][
          center_folds[[cn]] == k,
          ,
          drop = FALSE
        ]
      }
    )
  )
  
  surv_outer_val <- do.call(
    rbind,
    lapply(
      center_names,
      function(cn) {
        surv_list[[cn]][
          center_folds[[cn]] == k,
          ,
          drop = FALSE
        ]
      }
    )
  )
  
  clin_outer_val <- do.call(
    rbind,
    lapply(
      center_names,
      function(cn) {
        clinical_list[[cn]][
          center_folds[[cn]] == k,
          ,
          drop = FALSE
        ]
      }
    )
  )
  
  ##  BW pre-filtering between outer-train and outer-val (hybrid) 
  bw_prefilter_hybrid_outer <- compute_bw_prefilter(
    X_train      = X_outer_train,
    X_val        = X_outer_val,
    time_train   = surv_outer_train$time,
    event_train  = surv_outer_train$event,
    center_train = center_outer_train,
    n_keep       = n_keep,
    n_cores      = n_cores
  )
  cat(
    "BW pre-filtering (outer", k, "):",
    round(bw_prefilter_hybrid_outer$bw, 4),
    "over", bw_prefilter_hybrid_outer$n_vars, "variables\n"
  )
  
  nested_result <- select_best_model_inner(
    X_outer_train = X_outer_train,
    surv_outer_train = surv_outer_train,
    clin_outer_train = clin_outer_train,
    center_outer_train = center_outer_train,
    K_inner = K_inner,
    n_keep = n_keep,
    n_cores = n_cores,
    seed = 20000 + k
  )
  
  if (is.null(nested_result)) {
    warning("No best model for outer fold ", k)
    next
  }
  
  best_model <- nested_result$best_model
  best_variables <- nested_result$best_variables
  
  best_metrics <- evaluate_model(
    fit = best_model,
    consensus_vars = best_variables,
    X_test = X_outer_val,
    surv_test = surv_outer_val,
    clin_test = clin_outer_val,
    X_train_full = X_outer_train[, best_variables, drop = FALSE],
    X_test_full = X_outer_val[, best_variables, drop = FALSE],
    T_AUC = T_AUC
  )
  
  ## add BW pre-filtering to the metrics vector 
  best_metrics <- c(best_metrics, bw_prefilter = bw_prefilter_hybrid_outer$bw)
  
  best_models_hybrid[[paste0("outer", k)]] <- best_model
  best_variables_hybrid[[paste0("outer", k)]] <- best_variables
  best_metrics_hybrid[[paste0("outer", k)]] <- best_metrics
  
  cat(
    "Variables:", length(best_variables),
    "| C-index:", round(best_metrics["cindex"], 4),
    "\n"
  )
}

##############################################################
## CONSENSUS ACROSS THE 4 BEST MODELS
##############################################################

valid_best <- which(
  sapply(
    best_variables_hybrid,
    function(x) !is.null(x)
  )
)

if (length(valid_best) == 0) {
  stop("No valid BEST MODEL in the hybrid strategy.")
}

all_best_variables <- unique(
  unlist(best_variables_hybrid[valid_best])
)

selection_matrix_hybrid <- matrix(
  0,
  nrow = length(valid_best),
  ncol = length(all_best_variables),
  dimnames = list(
    names(best_variables_hybrid)[valid_best],
    all_best_variables
  )
)

for (i in seq_along(valid_best)) {
  vars_i <- best_variables_hybrid[[valid_best[i]]]
  selection_matrix_hybrid[i, vars_i] <- 1
}

frequency_best_models <- colMeans(
  selection_matrix_hybrid
)

consensus_vars_hybrid <- names(
  frequency_best_models[
    frequency_best_models >= tau_consensus
  ]
)

cat("\n============================================================\n")
cat("HYBRID CONSENSUS\n")
cat("Number of BEST MODELS:", length(valid_best), "\n")
cat("Consensus variables:", length(consensus_vars_hybrid), "\n")
cat("Threshold: >", tau_consensus * 100, "%\n")
cat("Clinical variables: AGE + TNM\n")
cat("============================================================\n")

consensus_frequency_table <- data.frame(
  variable = names(frequency_best_models),
  frequency = as.numeric(frequency_best_models),
  selected = names(frequency_best_models) %in% consensus_vars_hybrid,
  row.names = NULL
)

consensus_frequency_table <- consensus_frequency_table[
  order(-consensus_frequency_table$frequency),
  ,
  drop = FALSE
]

print(consensus_frequency_table)

