##############################################################
## UNIVARIATE FILTERING
## Selection on top 2000 p-values transcriptomic covariables
##############################################################

univariate_cox_pval_strata <- function(j, Xmat, time, event, center) {
  x <- Xmat[, j]
  fit <- tryCatch(
    coxph(Surv(time, event) ~ x + strata(center)),
    error = function(e) NULL
  )
  if (is.null(fit)) return(NA_real_)
  coef_table <- summary(fit)$coefficients
  if (is.null(coef_table) || nrow(coef_table) == 0) return(NA_real_)
  pval <- coef_table[1, "Pr(>|z|)"]
  if (!is.finite(pval)) return(NA_real_)
  pval
}

compute_pvals <- function(Xmat, time, event, center, n_cores) {
  if (.Platform$OS.type == "windows") {
    cl <- makeCluster(n_cores)
    on.exit(stopCluster(cl), add = TRUE)
    clusterExport(cl, "univariate_cox_pval_strata", envir = environment())
    clusterEvalQ(cl, library(survival))
    pv <- parSapply(
      cl,
      seq_len(ncol(Xmat)),
      univariate_cox_pval_strata,
      Xmat = Xmat,
      time = time,
      event = event,
      center = center
    )
  } else {
    pv <- unlist(mclapply(
      seq_len(ncol(Xmat)),
      univariate_cox_pval_strata,
      Xmat = Xmat,
      time = time,
      event = event,
      center = center,
      mc.cores = n_cores
    ))
  }
  names(pv) <- colnames(Xmat)
  pv
}

select_top_variables <- function(pvals, n_keep) {
  pvals <- pvals[is.finite(pvals)]
  pvals <- sort(pvals)
  if (length(pvals) == 0) return(character(0))
  names(pvals)[seq_len(min(n_keep, length(pvals)))]
}

################################################################
## COX REFIT: OMICS VARIABLES + AGE + TNM
## Final Cox fit with re-introduction of AGE and TNM covariables
## + selected transcriptomics variables
################################################################

refit_cox_fixed_vars <- function(X, surv_df, clin_df, vars) {
  if (length(vars) > 0) {
    df <- as.data.frame(X[, vars, drop = FALSE])
    colnames(df) <- make.names(vars)
  } else {
    df <- data.frame(row.names = seq_len(nrow(X)))
  }
  df$AGE <- clin_df$AGE
  df$TNM <- clin_df$TNM
  df$time <- surv_df$time
  df$event <- surv_df$event
  coxph(
    Surv(time, event) ~ .,
    data = df,
    x = TRUE,
    y = TRUE
  )
}

##############################################################
## EVALUATION
##############################################################

evaluate_model <- function(fit, consensus_vars, X_test, surv_test, clin_test,
                           X_train_full, X_test_full, T_AUC = 3) {
  if (length(consensus_vars) > 0) {
    df_test <- as.data.frame(X_test[, consensus_vars, drop = FALSE])
    colnames(df_test) <- make.names(consensus_vars)
  } else {
    df_test <- data.frame(row.names = seq_len(nrow(X_test)))
  }
  df_test$AGE <- clin_test$AGE
  df_test$TNM <- clin_test$TNM
  df_test$time <- surv_test$time
  df_test$event <- surv_test$event
  
  lp_test <- tryCatch(
    predict(fit, newdata = df_test, type = "lp"),
    error = function(e) rep(NA_real_, nrow(df_test))
  )
  
  valid <- is.finite(lp_test)
  time_auc <- surv_test$time[valid]
  event_auc <- surv_test$event[valid]
  marker_auc <- lp_test[valid]
  
  auc_obj <- tryCatch(
    timeROC(
      T = time_auc,
      delta = event_auc,
      marker = marker_auc,
      cause = 1,
      times = T_AUC
    )$AUC[2],
    error = function(e) NA_real_
  )
  
  cindex_val <- tryCatch(
    as.numeric(
      Hmisc::rcorr.cens(
        -lp_test[valid],
        Surv(
          surv_test$time[valid],
          surv_test$event[valid]
        )
      )["C Index"]
    ),
    error = function(e) NA_real_
  )
  
  brier_t3 <- NA_real_
  ibs_t3 <- NA_real_
  
  pec_fit <- tryCatch(
    pec(
      object = list(Cox = fit),
      formula = Surv(time, event) ~ 1,
      data = df_test,
      exact = FALSE,
      cens.model = "marginal",
      splitMethod = "none"
    ),
    error = function(e) NULL
  )
  
  if (!is.null(pec_fit)) {
    crps_values <- tryCatch(
      as.numeric(crps(pec_fit, times = T_AUC, start = 0)[2]),
      error = function(e) NA_real_
    )
  } else {
    crps_values <- NA_real_
  }
  
  bw_dist <- tryCatch(
    {
      Sigma1 <- cov(X_train_full)
      Sigma2 <- cov(X_test_full)
      Sigma1 <- Sigma1 + diag(1e-8, ncol(Sigma1))
      Sigma2 <- Sigma2 + diag(1e-8, ncol(Sigma2))
      sqrt_S1 <- Re(expm::sqrtm(Sigma1))
      M <- sqrt_S1 %*% Sigma2 %*% sqrt_S1
      sqrt_M <- Re(expm::sqrtm(M))
      val <- sum(diag(Sigma1)) + sum(diag(Sigma2)) - 2 * sum(diag(sqrt_M))
      sqrt(max(val, 0))
    },
    error = function(e) NA_real_
  )
  
  c(
    auc = auc_obj,
    cindex = cindex_val,
    brier = crps_values,
    ibs = crps_values,
    bw = bw_dist
  )
}

##############################################################
## BURES-WASSERSTEIN ON THE PRE-FILTERING MATRICES
##############################################################
##
## Unlike the "bw" computed in evaluate_model() (which operates
## on the POST-LASSO variables), this function redoes the
## univariate filtering (top n_keep) ON THE TRAIN SET ONLY (no
## information leakage), applies the same variable set to the
## validation/test set, then computes the BW distance on these
## pre-filtered matrices.

compute_bw_prefilter <- function(X_train, X_val,
                                 time_train, event_train,
                                 center_train = NULL,
                                 n_keep = 2000,
                                 n_cores = 1) {
  
  if (is.null(center_train)) {
    center_train <- factor(rep("all", nrow(X_train)))
  }
  
  ## 1) Univariate filtering on the train set only
  pvals <- tryCatch(
    compute_pvals(
      X_train,
      time_train,
      event_train,
      center_train,
      n_cores
    ),
    error = function(e) NULL
  )
  if (is.null(pvals)) {
    return(list(bw = NA_real_, n_vars = 0L, vars = character(0)))
  }
  
  vars_prefilter <- select_top_variables(pvals, n_keep)
  vars_prefilter <- intersect(vars_prefilter, colnames(X_val))
  
  if (length(vars_prefilter) < 2) {
    return(list(bw = NA_real_, n_vars = length(vars_prefilter), vars = vars_prefilter))
  }
  
  Xtr <- X_train[, vars_prefilter, drop = FALSE]
  Xva <- X_val[,   vars_prefilter, drop = FALSE]
  
  ## 2) Bures-Wasserstein distance on the covariance matrices
  bw <- tryCatch(
    {
      Sigma1 <- cov(Xtr)
      Sigma2 <- cov(Xva)
      
      Sigma1 <- Sigma1 + diag(1e-8, ncol(Sigma1))
      Sigma2 <- Sigma2 + diag(1e-8, ncol(Sigma2))
      
      sqrt_S1 <- Re(expm::sqrtm(Sigma1))
      M       <- sqrt_S1 %*% Sigma2 %*% sqrt_S1
      sqrt_M  <- Re(expm::sqrtm(M))
      
      val <- sum(diag(Sigma1)) + sum(diag(Sigma2)) - 2 * sum(diag(sqrt_M))
      sqrt(max(val, 0))
    },
    error = function(e) NA_real_
  )
  
  list(bw = bw, n_vars = length(vars_prefilter), vars = vars_prefilter)
}

##############################################################
## NESTED CV WITHIN AN OUTER TRAINING SET
##############################################################

select_best_model_inner <- function(X_outer_train, surv_outer_train,
                                    clin_outer_train, center_outer_train,
                                    K_inner = 10, n_keep = 2000,
                                    n_cores = 1, seed = 1) {
  set.seed(seed)
  n <- nrow(X_outer_train)
  inner_folds <- sample(rep(1:K_inner, length.out = n))
  models_inner <- list()
  variables_inner <- list()
  metrics_inner <- list()
  for (j in seq_len(K_inner)) {
    idx_train <- which(inner_folds != j)
    idx_val <- which(inner_folds == j)
    if (length(idx_train) < 10 || length(idx_val) < 5) next
    X_tr <- X_outer_train[idx_train, , drop = FALSE]
    X_val <- X_outer_train[idx_val, , drop = FALSE]
    surv_tr <- surv_outer_train[idx_train, , drop = FALSE]
    surv_val <- surv_outer_train[idx_val, , drop = FALSE]
    clin_tr <- clin_outer_train[idx_train, , drop = FALSE]
    clin_val <- clin_outer_train[idx_val, , drop = FALSE]
    center_tr <- center_outer_train[idx_train]
    pvals <- tryCatch(
      compute_pvals(
        X_tr,
        surv_tr$time,
        surv_tr$event,
        center_tr,
        n_cores
      ),
      error = function(e) NULL
    )
    if (is.null(pvals)) next
    vars <- select_top_variables(pvals, n_keep)
    if (length(vars) == 0) next
    vars <- intersect(vars, colnames(X_tr))
    if (length(vars) == 0) next
    X_tr_filtered <- X_tr[, vars, drop = FALSE]
    cvfit <- tryCatch(
      cv.glmnet(
        X_tr_filtered,
        Surv(surv_tr$time, surv_tr$event),
        family = "cox",
        nfolds = min(10, nrow(X_tr_filtered))
      ),
      error = function(e) NULL
    )
    if (is.null(cvfit)) next
    coef_lasso <- tryCatch(
      as.numeric(coef(cvfit, s = "lambda.min")),
      error = function(e) NULL
    )
    if (is.null(coef_lasso)) next
    if (length(coef_lasso) != length(vars)) next
    selected <- vars[is.finite(coef_lasso) & coef_lasso != 0]
    selected <- unique(selected)
    if (length(selected) == 0) next
    fit <- tryCatch(
      refit_cox_fixed_vars(
        X_tr,
        surv_tr,
        clin_tr,
        selected
      ),
      error = function(e) NULL
    )
    if (is.null(fit)) next
    metric <- tryCatch(
      evaluate_model(
        fit = fit,
        consensus_vars = selected,
        X_test = X_val,
        surv_test = surv_val,
        clin_test = clin_val,
        X_train_full = X_tr[, selected, drop = FALSE],
        X_test_full = X_val[, selected, drop = FALSE],
        T_AUC = T_AUC
      ),
      error = function(e) NULL
    )
    if (is.null(metric)) next
    cindex_value <- suppressWarnings(
      as.numeric(metric["cindex"])
    )
    if (length(cindex_value) != 1 || !is.finite(cindex_value)) next
    models_inner[[length(models_inner) + 1L]] <- fit
    variables_inner[[length(variables_inner) + 1L]] <- selected
    metrics_inner[[length(metrics_inner) + 1L]] <- metric
  }
  if (length(metrics_inner) == 0) return(NULL)
  cindices <- vapply(
    metrics_inner,
    function(x) {
      val <- suppressWarnings(
        as.numeric(x["cindex"])
      )
      if (length(val) != 1 || !is.finite(val)) {
        return(NA_real_)
      }
      val
    },
    numeric(1)
  )
  valid <- which(
    is.finite(cindices)
  )
  if (length(valid) == 0) return(NULL)
  best_idx <- valid[
    which.max(cindices[valid])
  ]
  list(
    best_model = models_inner[[best_idx]],
    best_variables = variables_inner[[best_idx]],
    best_metrics = metrics_inner[[best_idx]],
    all_models = models_inner,
    all_variables = variables_inner,
    all_metrics = metrics_inner
  )
}

##############################################################
## STRATEGY 1: EXTERNAL LOCO NESTED CV
## this strategy is considered as the standard with true external 
## assessment of predictive performances with standard deviation 
## assessment according to centres iteration
## no selected interpretation of covariable wil bb presented with 
## this approach because of the variability of the models according to the iteratios
##############################################################

results_external <- list()
models_external <- list()
variables_external <- list()
consensus_external <- list()

for (test_center in center_names) {
  cat("\n============================================================\n")
  cat("EXTERNAL CENTER:", test_center, "\n")
  cat("============================================================\n")
  
  train_centers <- setdiff(center_names, test_center)
  
  X_dev <- do.call(rbind, omics_list[train_centers])
  surv_dev <- do.call(rbind, surv_list[train_centers])
  clin_dev <- do.call(rbind, clinical_list[train_centers])
  
  center_dev <- factor(
    rep(
      train_centers,
      sapply(omics_list[train_centers], nrow)
    )
  )
  
  X_external <- omics_list[[test_center]]
  surv_external <- surv_list[[test_center]]
  clin_external <- clinical_list[[test_center]]
  
  set.seed(1000 + which(center_names == test_center))
  outer_folds <- sample(rep(1:K_outer, length.out = nrow(X_dev)))
  
  best_variables_outer <- list()
  best_models_outer <- list()
  best_metrics_outer <- list()
  
  for (o in seq_len(K_outer)) {
    cat("\nOuter fold", o, "/", K_outer, "\n")
    
    idx_train <- which(outer_folds != o)
    idx_val <- which(outer_folds == o)
    
    X_outer_train <- X_dev[idx_train, , drop = FALSE]
    X_outer_val <- X_dev[idx_val, , drop = FALSE]
    surv_outer_train <- surv_dev[idx_train, , drop = FALSE]
    surv_outer_val <- surv_dev[idx_val, , drop = FALSE]
    clin_outer_train <- clin_dev[idx_train, , drop = FALSE]
    clin_outer_val <- clin_dev[idx_val, , drop = FALSE]
    center_outer_train <- center_dev[idx_train]
    
    ## --- BW pre-filtering between outer-train and outer-val ---
    bw_prefilter_outer <- compute_bw_prefilter(
      X_train      = X_outer_train,
      X_val        = X_outer_val,
      time_train   = surv_outer_train$time,
      event_train  = surv_outer_train$event,
      center_train = center_outer_train,
      n_keep       = n_keep,
      n_cores      = n_cores
    )
    cat(
      "BW pre-filtering (outer", o, "):",
      round(bw_prefilter_outer$bw, 4),
      "over", bw_prefilter_outer$n_vars, "variables\n"
    )
    
    nested_result <- select_best_model_inner(
      X_outer_train = X_outer_train,
      surv_outer_train = surv_outer_train,
      clin_outer_train = clin_outer_train,
      center_outer_train = center_outer_train,
      K_inner = K_inner,
      n_keep = n_keep,
      n_cores = n_cores,
      seed = 10000 + o
    )
    
    if (is.null(nested_result)) {
      cat("No valid model.\n")
      next
    }
    
    best_model <- nested_result$best_model
    best_variables <- nested_result$best_variables
    
    outer_metrics <- evaluate_model(
      fit = best_model,
      consensus_vars = best_variables,
      X_test = X_outer_val,
      surv_test = surv_outer_val,
      clin_test = clin_outer_val,
      X_train_full = X_outer_train[, best_variables, drop = FALSE],
      X_test_full = X_outer_val[, best_variables, drop = FALSE],
      T_AUC = T_AUC
    )
    
    ## --- add BW pre-filtering to the metrics vector ---
    outer_metrics <- c(outer_metrics, bw_prefilter = bw_prefilter_outer$bw)
    
    best_models_outer[[paste0("outer", o)]] <- best_model
    best_variables_outer[[paste0("outer", o)]] <- best_variables
    best_metrics_outer[[paste0("outer", o)]] <- outer_metrics
    
    cat(
      "Variables:", length(best_variables),
      "| C-index:", round(outer_metrics["cindex"], 4), "\n"
    )
  }
  
  valid_outer <- which(
    sapply(
      best_variables_outer,
      function(x) !is.null(x)
    )
  )
  
  if (length(valid_outer) == 0) {
    warning("No valid model for center ", test_center)
    next
  }
  
  all_candidates <- unique(
    unlist(best_variables_outer[valid_outer])
  )
  selection_matrix <- matrix(
    0,
    nrow = length(valid_outer),
    ncol = length(all_candidates),
    dimnames = list(
      names(best_variables_outer)[valid_outer],
      all_candidates
    )
  )
  for (i in seq_along(valid_outer)) {
    vars_i <- best_variables_outer[[valid_outer[i]]]
    selection_matrix[i, vars_i] <- 1
  }
  frequency_outer <- colMeans(selection_matrix)
  consensus_vars_external <- names(
    frequency_outer[
      frequency_outer >= tau_consensus
    ]
  )
  
  cat(
    "\nConsensus:", length(consensus_vars_external),
    "variables | threshold >", tau_consensus * 100, "%\n"
  )
  
  final_external_model <- refit_cox_fixed_vars(
    X_dev,
    surv_dev,
    clin_dev,
    consensus_vars_external
  )
  
  metrics_external <- evaluate_model(
    fit = final_external_model,
    consensus_vars = consensus_vars_external,
    X_test = X_external,
    surv_test = surv_external,
    clin_test = clin_external,
    X_train_full = X_dev[, consensus_vars_external, drop = FALSE],
    X_test_full = X_external[, consensus_vars_external, drop = FALSE],
    T_AUC = T_AUC
  )
  
  ## BW pre-filtering between dev (train) and external center (test) 
  bw_prefilter_external <- compute_bw_prefilter(
    X_train      = X_dev,
    X_val        = X_external,
    time_train   = surv_dev$time,
    event_train  = surv_dev$event,
    center_train = center_dev,
    n_keep       = n_keep,
    n_cores      = n_cores
  )
  metrics_external <- c(metrics_external, bw_prefilter = bw_prefilter_external$bw)
  
  results_external[[test_center]] <- metrics_external
  models_external[[test_center]] <- final_external_model
  variables_external[[test_center]] <- consensus_vars_external
  
  consensus_external[[test_center]] <- list(
    frequency = frequency_outer,
    selection_matrix = selection_matrix,
    best_variables = best_variables_outer
  )
  
  cat(
    "EXTERNAL TEST - AUC:",
    round(metrics_external["auc"], 4),
    "| C-index:",
    round(metrics_external["cindex"], 4),
    "| Brier:",
    round(metrics_external["brier"], 4),
    "| BW pre-filtering:",
    round(metrics_external["bw_prefilter"], 4),
    "\n"
  )
}

